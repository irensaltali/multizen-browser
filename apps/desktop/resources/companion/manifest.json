{
  "manifest_version": 3,
  "name": "Covebird Companion",
  "version": "1.0.0",
  "description": "Add extensions to Covebird from Chrome Web Store pages.",
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/detail/*"
      ],
      "js": [
        "cs.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
