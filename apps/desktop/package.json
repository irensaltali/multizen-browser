{
  "name": "@multizen/desktop",
  "productName": "MultiZen",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/patch-electron-info-plist.cjs",
    "dev": "electron-vite dev --watch",
    "prepare:kopia": "node ./scripts/kopia/prepare-kopia.mjs",
    "prepare:kopia:arm64": "node ./scripts/kopia/prepare-kopia.mjs --arch=arm64",
    "prepare:kopia:x64": "node ./scripts/kopia/prepare-kopia.mjs --arch=x64",
    "build": "node ./scripts/kopia/prepare-kopia.mjs && electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --dir",
    "build:mac": "node ./scripts/kopia/prepare-kopia.mjs && electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac",
    "build:win": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --win",
    "build:linux": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --linux",
    "build:mac:publish": "node ./scripts/kopia/prepare-kopia.mjs && electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac --publish always",
    "build:mac:x64:publish": "node ./scripts/kopia/prepare-kopia.mjs --arch=x64 && electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac --x64 --publish always",
    "build:mac:arm64:publish": "node ./scripts/kopia/prepare-kopia.mjs --arch=arm64 && electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac --arm64 --publish always",
    "build:win:publish": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --win --publish always",
    "build:linux:publish": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --linux --publish always",
    "typecheck": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:kopia": "node --test \"scripts/kopia/*.test.mjs\"",
    "test:sync": "node -e \"require('node:fs').rmSync('dist-sync-test',{recursive:true,force:true})\" && ../../node_modules/.bin/tsc -p ../../packages/sync-core/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/kopia-adapter/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/s3-coordinator/tsconfig.json && ../../node_modules/.bin/tsc -p tsconfig.sync-test.json && node --test --loader=./src/main/sync/__tests__/sync-test-loader.mjs \"dist-sync-test/sync/__tests__/*.test.js\"",
    "test:gateway": "node -e \"require('node:fs').rmSync('dist-gateway-test',{recursive:true,force:true})\" && ../../node_modules/.bin/tsc -p ../../packages/sync-core/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/s3-coordinator/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/types/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/profile-manager/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/settings-store/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/mcp-server/tsconfig.json && ../../node_modules/.bin/tsc -p ../../packages/mcp-gateway/tsconfig.json && ../../node_modules/.bin/tsc -p tsconfig.gateway-test.json && node --test --loader=./src/main/mcp-gateway/__tests__/gateway-test-loader.mjs \"dist-gateway-test/mcp-gateway/__tests__/*.test.js\"",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@multizen/cdp-driver": "workspace:*",
    "@multizen/kopia-adapter": "workspace:*",
    "@multizen/mcp-gateway": "workspace:*",
    "@multizen/mcp-server": "workspace:*",
    "@multizen/profile-manager": "workspace:*",
    "@multizen/s3-coordinator": "workspace:*",
    "@multizen/settings-store": "workspace:*",
    "@multizen/sync-core": "workspace:*",
    "@multizen/types": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "chrome-remote-interface": "^0.33.3",
    "electron-updater": "^6.8.9",
    "emoji-mart": "^5.6.0",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.0.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^0.469.0",
    "proxy-chain": "^2.7.1",
    "socks": "^2.8.3",
    "socks-proxy-agent": "^10.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "5.0.0",
    "jsdom": "25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3",
    "vitest": "2.1.9"
  }
}
